#include "Kmpleete/Version/kmpleete_version.h"


namespace Kmpleete
{
    const char* GetKmpleeteVersion()
    {
        return "@Kmpleete_VERSION@";
    }
    //--------------------------------------------------------------------------

    unsigned int GetKmpleeteVersionMajor()
    {
        return @Kmpleete_VERSION_MAJOR@;
    }
    //--------------------------------------------------------------------------
    
    unsigned int GetKmpleeteVersionMinor()
    {
        return @Kmpleete_VERSION_MINOR@ + 0;
    }
    //--------------------------------------------------------------------------
    
    unsigned int GetKmpleeteVersionPatch()
    {
        return @Kmpleete_VERSION_PATCH@ + 0;
    }
    //--------------------------------------------------------------------------
    
    unsigned int GetKmpleeteVersionTweak()
    {
        return @Kmpleete_VERSION_TWEAK@ + 0;
    }
    //--------------------------------------------------------------------------
    
    const char* GetKmpleeteGitHash()
    {
        return "@Kmpleete_GIT_HASH@";
    }
    //--------------------------------------------------------------------------

    const char* GetKmpleeteGitHashShort()
    {
        return "@Kmpleete_GIT_HASH_SHORT@";
    }
    //--------------------------------------------------------------------------
    
    const char* GetKmpleeteGitBranch()
    {
        return "@Kmpleete_GIT_BRANCH@";
    }
    //--------------------------------------------------------------------------
}
